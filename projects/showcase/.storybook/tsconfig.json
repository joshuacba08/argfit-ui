{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler"
  },
  "exclude": ["../src/test.ts", "../src/**/*.spec.ts"],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.stories.*",
    "../../argfit-ui-core/src/**/*.ts",
    "../../argfit-ui-primitives/src/**/*.ts",
    "../../argfit-ui-desktop/src/**/*.ts",
    "../../argfit-ui-mobile/src/**/*.ts",
    "../../argfit-ui-adaptive/src/**/*.ts",
    "./main.ts",
    "./manager.ts",
    "./preview.ts"
  ],
  "files": ["./typings.d.ts"]
}
