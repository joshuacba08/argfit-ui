{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argfit.dev/schemas/command-palette.schema.json",
  "title": "ArgFit Command Palette configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "commands"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "shortcut": { "type": "string", "default": "Mod+K" },
    "defaultMode": { "type": "string" },
    "maxResults": { "type": "integer", "minimum": 1, "default": 50 },
    "showTrigger": { "type": "boolean", "default": true },
    "labels": { "$ref": "#/$defs/labels" },
    "history": { "$ref": "#/$defs/history" },
    "modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/mode" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection" }
    },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placeholder": { "type": "string" },
        "emptyText": { "type": "string" },
        "loadingText": { "type": "string" },
        "ariaLabel": { "type": "string" },
        "closeLabel": { "type": "string" },
        "backLabel": { "type": "string" },
        "retryLabel": { "type": "string" },
        "unavailableText": { "type": "string" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "storageKey": { "type": "string" },
        "maxEntries": { "type": "integer", "minimum": 1, "default": 50 }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "minLength": 1, "maxLength": 1 },
        "placeholder": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "minQueryLength": { "type": "integer", "minimum": 0 },
        "debounceMs": { "type": "integer", "minimum": 0 },
        "priority": { "type": "number" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/jsonValue" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "disabled": { "type": "boolean" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "number", "select", "multiselect", "date", "boolean", "confirm"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "defaultValue": { "$ref": "#/$defs/jsonValue" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "providerId": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" }
      }
    },
    "entityMedia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageSrc": { "type": "string" },
        "initials": { "type": "string" },
        "icon": { "type": "string" },
        "shape": { "enum": ["circle", "rounded", "square"] }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": { "const": "entity" },
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "number" },
        "disabled": { "type": "boolean" },
        "disabledReason": { "type": "string" },
        "media": { "$ref": "#/$defs/entityMedia" },
        "metadata": { "type": "array", "items": { "type": "string" } },
        "data": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "icon": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "activator": { "type": "string", "pattern": "^@[A-Za-z0-9][A-Za-z0-9-]*$" },
        "priority": { "type": "number" },
        "showInRoot": { "type": "boolean" },
        "when": { "type": "string" },
        "enabledWhen": { "type": "string" },
        "disabledReason": { "type": "string" },
        "presentation": { "enum": ["entity-card", "compact"] },
        "placeholder": { "type": "string" },
        "emptyText": { "type": "string" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "providerId": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "actionsProviderId": { "type": "string" }
      },
      "allOf": [
        { "anyOf": [{ "required": ["entities"] }, { "required": ["providerId"] }] },
        { "anyOf": [{ "required": ["actions"] }, { "required": ["actionsProviderId"] }] }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "icon": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "keybinding": { "type": "string" },
        "priority": { "type": "number" },
        "pinned": { "type": "boolean" },
        "when": { "type": "string" },
        "enabledWhen": { "type": "string" },
        "disabledReason": { "type": "string" },
        "executorId": { "type": "string" },
        "payload": { "$ref": "#/$defs/jsonValue" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "childrenProviderId": { "type": "string" }
      },
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["executorId", "children"] },
              { "required": ["executorId", "childrenProviderId"] },
              { "required": ["children", "childrenProviderId"] }
            ]
          }
        }
      ]
    }
  }
}
