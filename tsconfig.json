/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "argfit-ui-adaptive": ["./dist/argfit-ui-adaptive"],
      "argfit-ui-core": ["./dist/argfit-ui-core"],
      "argfit-ui-desktop": ["./dist/argfit-ui-desktop"],
      "argfit-ui-mobile": ["./dist/argfit-ui-mobile"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/argfit-ui-core/tsconfig.lib.json"
    },
    {
      "path": "./projects/argfit-ui-core/tsconfig.spec.json"
    },
    {
      "path": "./projects/argfit-ui-desktop/tsconfig.lib.json"
    },
    {
      "path": "./projects/argfit-ui-desktop/tsconfig.spec.json"
    },
    {
      "path": "./projects/argfit-ui-mobile/tsconfig.lib.json"
    },
    {
      "path": "./projects/argfit-ui-mobile/tsconfig.spec.json"
    },
    {
      "path": "./projects/argfit-ui-adaptive/tsconfig.lib.json"
    },
    {
      "path": "./projects/argfit-ui-adaptive/tsconfig.spec.json"
    },
    {
      "path": "./projects/showcase/tsconfig.app.json"
    },
    {
      "path": "./projects/showcase/tsconfig.spec.json"
    }
  ]
}
